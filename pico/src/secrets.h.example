// Copy to secrets.h (git-ignored) and fill in.
// Required on the Pico 2 W. Optional on the plain Pico 2, which only uses
// SERVICE_URLS (default: the USB host, http://192.168.71.2:8080).

#define WIFI_SSID     "your-network"
#define WIFI_PASSWORD "your-password"

// Transcription service base URLs in priority order, comma-separated (up to 4).
// Each press uses the first one ready to accept the recording.
// http only; hostnames are resolved through the DNS servers DHCP provides.
// 192.168.71.2 is the USB host, over USB networking (see host/host-setup.sh);
// it fails through at once while the host has not configured the USB device.
#define SERVICE_URLS  "http://192.168.71.2:8080,http://gpu-host.lan:8080,http://192.168.1.20:8080"
